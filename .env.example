# RevenueCat Google Play API Key (for Android native Capacitor app)
# Replace with your Google API Key from the RevenueCat Dashboard -> Project -> API Keys
VITE_REVENUECAT_GOOGLE_API_KEY=goog_placeholder_api_key

# RevenueCat Web Billing Public API Key (for Web browser fallback)
# Replace with your Test Store or Production Web Billing key from the RevenueCat Dashboard
VITE_REVENUECAT_PUBLIC_KEY=your_revenuecat_public_api_key_here
